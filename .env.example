# MongoDB Connection
# For local development:
# MONGODB_URI=mongodb://localhost:27017/promice-studios
# For production (MongoDB Atlas):
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/promice-studios?retryWrites=true&w=majority

# NextAuth Configuration
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=generate-a-long-random-secret-key-here

# Admin Credentials (for initial setup)
ADMIN_EMAIL=admin@promice.com
ADMIN_PASSWORD=your-secure-password
